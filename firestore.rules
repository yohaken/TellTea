rules_version = '2';
// TellTea shop · Who×Action×Where (≤50 lines) · UI filters menus
// Archive: firestore.rules.full.bak · Sibling apps must not deploy rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'yohaken@gmail.com';
    }
    function isOwnUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Auth bridge tickets
    match /loginTickets/{ticketId} {
      allow create: if signedIn() && request.auth.token.email != null;
      allow get, delete: if true;
      allow list, update: if false;
    }

    // Sibling apps on mypeer-501909 (exclude from shop catch-all)
    match /taxtag/{uid} {
      allow read, write: if isOwnUid(uid) && isOwnerEmail();
    }
    match /userData/{userId} {
      allow read, write: if isOwnUid(userId);
      match /{document=**} {
        allow read, write: if isOwnUid(userId);
      }
    }

    // Shop + POS (incl. anonymous Auth)
    match /{collection}/{document=**} {
      allow read, write: if signedIn()
        && collection != 'taxtag'
        && collection != 'userData'
        && collection != 'loginTickets';
    }
  }
}
