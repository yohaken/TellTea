rules_version = '2';
// TellTea shop · Who×Action×Where (≤55 lines) · UI filters menus
// Archive: firestore.rules.full.bak · Sibling apps must not deploy rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'yohaken@gmail.com';
    }
    function isOwnUid(uid) { return signedIn() && request.auth.uid == uid; }
    match /loginTickets/{ticketId} {
      allow create: if signedIn() && request.auth.token.email != null;
      allow get, delete: if true;
      allow list, update: if false;
    }
    match /taxtag/{uid} { allow read, write: if isOwnUid(uid) && isOwnerEmail(); }
    match /userData/{userId} {
      allow read, write: if isOwnUid(userId);
      match /{document=**} { allow read, write: if isOwnUid(userId); }
    }
    // Admin-SDK write: weather · secrets · stock low LINE state
    match /weatherDays/{dateId} { allow read: if signedIn(); allow write: if false; }
    match /finpeerSecrets/{docId} { allow read, write: if false; }
    match /stockLowAlerts/{id} { allow read: if isOwnerEmail(); allow write: if false; }
    // unitCost owner-only (menuSops/menuSopCosts = qty links, no prices)
    match /stockCosts/{itemId} { allow read, write: if isOwnerEmail(); }
    match /stockCostHistory/{histId} { allow read, write: if isOwnerEmail(); }
    match /meta/{docId} {
      allow get: if docId == 'brandLogo' || docId == 'businessProfile' || signedIn();
      allow list: if false;
      allow write: if signedIn();
    }
    // evidencePhotos: staff get/create; owner list/delete
    match /evidencePhotos/{photoId} {
      allow get, create, update: if signedIn();
      allow list, delete: if isOwnerEmail();
    }
    match /{collection}/{document=**} {
      allow read, write: if signedIn()
        && collection != 'taxtag'
        && collection != 'userData'
        && collection != 'loginTickets'
        && collection != 'weatherDays'
        && collection != 'finpeerSecrets'
        && collection != 'stockLowAlerts'
        && collection != 'stockCosts'
        && collection != 'stockCostHistory'
        && collection != 'evidencePhotos'
        && collection != 'meta';
    }
  }
}
