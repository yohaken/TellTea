rules_version = '2';
// Emergency = same as slim shop rules (keep deploy path small for Rules API)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'yohaken@gmail.com';
    }
    function isOwnUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /loginTickets/{ticketId} {
      allow create: if signedIn() && request.auth.token.email != null;
      allow get, delete: if true;
      allow list, update: if false;
    }

    match /taxtag/{uid} {
      allow read, write: if isOwnUid(uid) && isOwnerEmail();
    }
    match /userData/{userId} {
      allow read, write: if isOwnUid(userId);
      match /{document=**} {
        allow read, write: if isOwnUid(userId);
      }
    }

    match /{collection}/{document=**} {
      allow read, write: if signedIn()
        && collection != 'taxtag'
        && collection != 'userData'
        && collection != 'loginTickets';
    }
  }
}
