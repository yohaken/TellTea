<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Allow binding SUNMI built-in printer service on Android 11+. -->
    <queries>
        <package android:name="woyou.aidlservice.jiuiv5" />
        <intent>
            <action android:name="woyou.aidlservice.jiuiv5.IWoyouService" />
        </intent>
    </queries>

    <application
        android:name=".NposApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Npos"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SellActivity"
            android:exported="false"
            android:label="@string/sell_title" />

        <activity
            android:name=".MenuAdminActivity"
            android:exported="false"
            android:label="@string/menu_admin_title" />

        <activity
            android:name=".MenuItemEditActivity"
            android:exported="false"
            android:label="@string/menu_item_edit_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MenuGroupEditActivity"
            android:exported="false"
            android:label="@string/menu_group_edit_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ShiftActivity"
            android:exported="false"
            android:label="@string/nav_shift" />

        <activity
            android:name=".ReceiptsActivity"
            android:exported="false"
            android:label="@string/receipts_title" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".DiagnoseActivity"
            android:exported="false"
            android:label="@string/diagnose_title" />

        <activity
            android:name=".diagnose.CaptureConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:label="@string/capture_consent_title" />

        <service
            android:name=".diagnose.CaptureProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.telltea.npos.UPDATE_INSTALL_RESULT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
