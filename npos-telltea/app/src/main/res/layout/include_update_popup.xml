<?xml version="1.0" encoding="utf-8"?>
<!-- Centered forced-update overlay — compact card, single Update button -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/updatePopup"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/updatePopupCard"
        android:layout_width="288dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/npos_popup_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/prompt_semibold"
            android:gravity="center"
            android:text="@string/update_popup_title"
            android:textColor="@color/npos_ink"
            android:textSize="@dimen/npos_text_section" />

        <TextView
            android:id="@+id/updatePopupBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/prompt_regular"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/npos_muted"
            android:textSize="@dimen/npos_text_body" />

        <TextView
            android:id="@+id/updatePopupProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/prompt_medium"
            android:gravity="center"
            android:textColor="@color/npos_orange"
            android:textSize="@dimen/npos_text_caption"
            android:visibility="gone" />

        <!-- Kept gone for older code paths; forced update has one CTA only. -->
        <TextView
            android:id="@+id/updatePopupLater"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/updatePopupGo"
            style="@style/Npos.Btn.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="48dp"
            android:text="@string/btn_install_update"
            android:textSize="@dimen/npos_text_btn" />
    </LinearLayout>
</FrameLayout>
