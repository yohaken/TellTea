<?xml version="1.0" encoding="utf-8"?>
<!-- Top-left update popup — visible on sell/hub without opening Settings -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/updatePopup"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_gravity="top|start"
    android:layout_marginStart="12dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/npos_popup_card"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/prompt_semibold"
        android:text="@string/update_popup_title"
        android:textColor="@color/npos_ink"
        android:textSize="@dimen/npos_text_body" />

    <TextView
        android:id="@+id/updatePopupBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/prompt_regular"
        android:lineSpacingMultiplier="1.25"
        android:textColor="@color/npos_muted"
        android:textSize="@dimen/npos_text_caption" />

    <TextView
        android:id="@+id/updatePopupProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/prompt_medium"
        android:textColor="@color/npos_orange"
        android:textSize="@dimen/npos_text_caption"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/updatePopupLater"
            style="@style/Npos.Btn.Ghost"
            android:layout_width="0dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:maxWidth="999dp"
            android:minHeight="40dp"
            android:text="@string/update_popup_later" />

        <TextView
            android:id="@+id/updatePopupGo"
            style="@style/Npos.Btn.Primary"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:maxWidth="999dp"
            android:minHeight="40dp"
            android:text="@string/btn_install_update"
            android:textSize="@dimen/npos_text_btn_sm" />
    </LinearLayout>
</LinearLayout>
