<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/npos_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/backButton"
                style="@style/Npos.Btn.Back"
                android:text="@string/btn_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/prompt_semibold"
                android:text="@string/diagnose_title"
                android:textColor="@color/npos_ink"
                android:textSize="@dimen/npos_text_title" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/prompt_regular"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/diagnose_hint"
            android:textColor="@color/npos_muted"
            android:textSize="@dimen/npos_text_caption" />

        <TextView
            android:id="@+id/refreshButton"
            style="@style/Npos.Btn.Secondary"
            android:layout_marginTop="14dp"
            android:text="@string/diagnose_refresh" />

        <TextView
            android:id="@+id/reportButton"
            style="@style/Npos.Btn.Ghost"
            android:layout_marginTop="8dp"
            android:text="@string/diagnose_report" />

        <TextView
            android:id="@+id/diagnoseStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/prompt_regular"
            android:textColor="@color/npos_muted"
            android:textSize="@dimen/npos_text_body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/npos_space_section"
            android:fontFamily="@font/prompt_semibold"
            android:text="@string/diagnose_displays_title"
            android:textColor="@color/npos_ink"
            android:textSize="@dimen/npos_text_section" />

        <LinearLayout
            android:id="@+id/displayList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/npos_space_section"
            android:fontFamily="@font/prompt_semibold"
            android:text="@string/diagnose_hardware_title"
            android:textColor="@color/npos_ink"
            android:textSize="@dimen/npos_text_section" />

        <TextView
            android:id="@+id/hardwareList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/prompt_regular"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/npos_ink"
            android:textSize="@dimen/npos_text_body" />
    </LinearLayout>
</ScrollView>
