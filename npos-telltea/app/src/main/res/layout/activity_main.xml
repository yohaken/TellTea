<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/npos_bg_soft">

    <!-- Clock-in (shift closed) -->
    <ScrollView
        android:id="@+id/clockInPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:fontFamily="@font/prompt_bold"
                android:letterSpacing="-0.01"
                android:text="@string/app_name"
                android:textColor="@color/npos_ink"
                android:textSize="@dimen/npos_text_brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/prompt_semibold"
                android:text="@string/clock_in_title"
                android:textColor="@color/npos_ink"
                android:textSize="@dimen/npos_text_title" />

            <TextView
                android:id="@+id/clockInTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/prompt_bold"
                android:textColor="@color/npos_ink"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/clockInDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/prompt_regular"
                android:textColor="@color/npos_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/deviceIdView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/prompt_semibold"
                android:gravity="center"
                android:textColor="@color/npos_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/heartbeatStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/heartbeat_idle"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#888888"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/permStatusView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="#8A4B12"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/grantPermsButton"
                style="@style/Npos.Btn.Ghost"
                android:layout_marginTop="10dp"
                android:text="@string/btn_grant_all_perms"
                android:visibility="gone" />

            <TextView
                android:id="@+id/storeClaimHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/store_claim_hint"
                android:textColor="#8A4B12"
                android:textSize="14sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/storeClaimInput"
                style="@style/Npos.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:hint="@string/store_claim_input_hint"
                android:inputType="textCapCharacters"
                android:maxLength="16"
                android:maxWidth="@dimen/npos_btn_max_w"
                android:textSize="17sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/storeClaimButton"
                style="@style/Npos.Btn.Secondary"
                android:layout_marginTop="10dp"
                android:text="@string/store_claim_btn"
                android:visibility="gone" />

            <TextView
                android:id="@+id/claimVersionChip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#5B6B7A"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/claimUpdateButton"
                style="@style/Npos.Btn.Ghost"
                android:layout_marginTop="8dp"
                android:text="@string/claim_update_btn"
                android:visibility="gone" />

            <TextView
                android:id="@+id/openShiftButton"
                style="@style/Npos.Btn.Primary"
                android:layout_marginTop="24dp"
                android:text="@string/btn_open_shift"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/settingsButtonClock"
                style="@style/Npos.Btn.Secondary"
                android:layout_marginTop="10dp"
                android:text="@string/btn_settings_short" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/clock_in_hint"
                android:textColor="#777777"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Hub after clock-in — web PosAppShell left rail + content -->
    <LinearLayout
        android:id="@+id/sellPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <include layout="@layout/include_pos_sidebar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A2E24"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/sellStatusStrip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hub_title"
                    android:textColor="#F3F6F2"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hubVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="#243B32"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="#F0C9A0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sellDeviceCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#C4A35A"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/hubShiftStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#243B32"
                android:padding="10dp"
                android:textColor="#D7E3DC"
                android:textSize="12sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/hubNavList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone" />
            </ScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/hub_rail_hint"
                android:textColor="#5A6570"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:id="@+id/closeShiftButton"
                    style="@style/Npos.Btn.Ghost"
                    android:layout_marginEnd="6dp"
                    android:text="@string/btn_close_shift" />

                <TextView
                    android:id="@+id/settingsButtonSell"
                    style="@style/Npos.Btn.Secondary"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_settings_short" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/include_update_popup" />
</FrameLayout>
