<?xml version="1.0" encoding="utf-8"?>
<!-- Table-view-first sell: left category rail · menu grid · cart + 2-button pay bar -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/npos_bg_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <include layout="@layout/include_pos_sidebar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/npos_chrome"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/sellHubButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@color/npos_chrome_soft"
                    android:contentDescription="@string/sell_hub_menu"
                    android:fontFamily="@font/prompt_bold"
                    android:gravity="center"
                    android:minWidth="40dp"
                    android:minHeight="40dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/sell_hub_glyph"
                    android:textColor="@color/npos_chrome_text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/sellTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/prompt_semibold"
                    android:maxLines="1"
                    android:text="@string/sell_title"
                    android:textColor="@color/npos_chrome_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/sellSearchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@color/npos_chrome_soft"
                    android:contentDescription="@string/sell_search_hint"
                    android:fontFamily="@font/prompt_bold"
                    android:gravity="center"
                    android:minWidth="40dp"
                    android:minHeight="40dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/sell_search_glyph"
                    android:textColor="@color/npos_chrome_text"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/sellSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@color/npos_chrome_soft"
                    android:fontFamily="@font/prompt_regular"
                    android:hint="@string/sell_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="40dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/npos_chrome_text"
                    android:textColorHint="@color/npos_chrome_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/sellVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@color/npos_chrome_soft"
                    android:fontFamily="@font/prompt_semibold"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="#F0C9A0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sellServerCheckChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@color/npos_orange"
                    android:fontFamily="@font/prompt_bold"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="@string/server_check_now"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/refreshMenuButton"
                    style="@style/Npos.Btn.Chip"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="0dp"
                    android:text="@string/btn_refresh_menu"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/sellSyncStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/prompt_regular"
                    android:textColor="#F0C9A0"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/shiftSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/npos_chrome_soft"
                android:fontFamily="@font/prompt_regular"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/npos_chrome_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/sellContentRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:padding="6dp">

                <!-- Left: vertical category table (scroll top→bottom) -->
                <ScrollView
                    android:id="@+id/categoryScroll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="14"
                    android:background="@color/npos_surface"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/categoryBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp" />
                </ScrollView>

                <!-- Drag: category ↔ menu -->
                <View
                    android:id="@+id/splitCatMenu"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:background="@color/npos_border"
                    android:contentDescription="@string/sell_split_cat_menu"
                    android:elevation="1dp" />

                <!-- Center: product grid -->
                <ScrollView
                    android:id="@+id/menuScroll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="51"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="vertical">

                    <GridLayout
                        android:id="@+id/menuGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alignmentMode="alignBounds"
                        android:columnCount="5"
                        android:padding="2dp"
                        android:useDefaultMargins="false" />
                </ScrollView>

                <!-- Drag: menu ↔ cart -->
                <View
                    android:id="@+id/splitMenuCart"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:background="@color/npos_border"
                    android:contentDescription="@string/sell_split_menu_cart"
                    android:elevation="1dp" />

                <!-- Right: cart ~35% X · text actions · tall pay bar ~18% Y -->
                <LinearLayout
                    android:id="@+id/cartColumn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="35"
                    android:background="#FFFFFF"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="2dp">

                        <TextView
                            android:id="@+id/cartTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/prompt_semibold"
                            android:text="@string/cart_title"
                            android:textColor="@color/npos_ink"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/cartBillRef"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/prompt_semibold"
                            android:text="@string/cart_bill_new"
                            android:textColor="@color/npos_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Cart tools: one text row · same size as line names · clear = orange -->
                    <LinearLayout
                        android:id="@+id/cartActionRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/discountButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/prompt_regular"
                            android:gravity="center"
                            android:minHeight="36dp"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="@string/sell_hub_discount"
                            android:textColor="@color/npos_ink"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/restoreHoldButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/prompt_regular"
                            android:gravity="center"
                            android:minHeight="36dp"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="@string/sell_hub_restore_hold"
                            android:textColor="@color/npos_ink"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/clearCartButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/prompt_semibold"
                            android:gravity="center"
                            android:minHeight="36dp"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="@string/sell_hub_clear_cart"
                            android:textColor="@color/npos_orange"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="82">

                        <LinearLayout
                            android:id="@+id/cartList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                    <!-- Totals live only inside pay button; keep IDs for wiring (hidden). -->
                    <LinearLayout
                        android:id="@+id/cartTotalsBlock"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/cartSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="฿0" />

                        <TextView
                            android:id="@+id/discountLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—" />

                        <TextView
                            android:id="@+id/cartTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cart_total_zero" />
                    </LinearLayout>

                    <!-- Footer: ชำระทั้งหมด (~85% X) + บันทึก · ~18% of cart Y -->
                    <LinearLayout
                        android:id="@+id/cartPayBar"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:layout_weight="18"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/payAllButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="85"
                            android:background="@drawable/npos_touch_primary"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:id="@+id/payAllLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/prompt_semibold"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/btn_pay_all"
                                android:textColor="@android:color/white"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/payAllAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/prompt_bold"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/cart_total_zero"
                                android:textColor="@android:color/white"
                                android:textSize="22sp" />

                            <TextView
                                android:id="@+id/payAllDiscount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/prompt_regular"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/pay_all_discount_none"
                                android:textColor="#E8F5EE"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/holdBillButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="15"
                            android:background="@drawable/npos_touch_secondary"
                            android:ellipsize="end"
                            android:fontFamily="@font/prompt_semibold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:text="@string/btn_hold_save"
                            android:textColor="@color/npos_orange"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/flushSyncButton"
                        style="@style/Npos.Btn.SellRow"
                        android:text="@string/btn_flush_sync"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/payCashButton"
                        style="@style/Npos.Btn.SellRow.Primary"
                        android:text="@string/btn_pay_cash"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/payTransferButton"
                        style="@style/Npos.Btn.SellRow"
                        android:text="@string/btn_pay_transfer"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/payPromptButton"
                        style="@style/Npos.Btn.SellRow"
                        android:text="@string/btn_pay_promptpay"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/xReportButton"
                        style="@style/Npos.Btn.SellRow"
                        android:text="@string/btn_x_report"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/backButton"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                    <View
                        android:id="@+id/receiptsButton"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                    <View
                        android:id="@+id/sellSettingsButton"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                    <View
                        android:id="@+id/sellCloseShiftButton"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/include_update_popup" />
</FrameLayout>
