<?xml version="1.0" encoding="utf-8"?>
<!-- Web PosAppShell: left sidebar + sell body (PosSellView 65/35) + update popup -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/npos_bg_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <include layout="@layout/include_pos_sidebar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/npos_chrome"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/sellTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/prompt_semibold"
                    android:text="@string/sell_title"
                    android:textColor="@color/npos_chrome_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/sellVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@color/npos_chrome_soft"
                    android:fontFamily="@font/prompt_semibold"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="#F0C9A0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/refreshMenuButton"
                    style="@style/Npos.Btn.Chip"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="0dp"
                    android:text="@string/btn_refresh_menu" />

                <TextView
                    android:id="@+id/sellSyncStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/prompt_regular"
                    android:textColor="#F0C9A0"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/shiftSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/npos_chrome_soft"
                android:fontFamily="@font/prompt_regular"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/npos_chrome_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:padding="6dp">

                <!-- Left ~65%: categories + menu grid -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="65"
                    android:orientation="vertical">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/categoryBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingBottom="6dp"
                            android:paddingTop="2dp" />
                    </HorizontalScrollView>

                    <ScrollView
                        android:id="@+id/menuScroll"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true"
                        android:overScrollMode="never"
                        android:scrollbars="vertical">

                        <GridLayout
                            android:id="@+id/menuGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alignmentMode="alignBounds"
                            android:columnCount="5"
                            android:padding="2dp"
                            android:useDefaultMargins="false" />
                    </ScrollView>
                </LinearLayout>

                <!-- Right ~35%: cart + totals + pay -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="35"
                    android:background="#FFFFFF"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/prompt_semibold"
                        android:text="@string/cart_title"
                        android:textColor="@color/npos_ink"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/priceChannelToggle"
                        style="@style/Npos.Btn.Ghost"
                        android:layout_marginTop="4dp"
                                                android:text="@string/price_channel_store" />

                    <TextView
                        android:id="@+id/clearCartButton"
                        style="@style/Npos.Btn.Ghost"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                                                android:text="@string/btn_clear_cart"
                        android:textColor="@color/npos_orange" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/cartList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                    <TextView
                        android:id="@+id/cartTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/prompt_semibold"
                        android:text="@string/cart_total_zero"
                        android:textColor="@color/npos_ink"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/discountLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/prompt_medium"
                        android:textColor="@color/npos_orange"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/discountButton"
                            style="@style/Npos.Btn.Chip"
                            android:layout_marginEnd="4dp"
                            android:text="@string/btn_discount"
                            android:textColor="@color/npos_orange" />

                        <TextView
                            android:id="@+id/holdBillButton"
                            style="@style/Npos.Btn.Chip"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:text="@string/btn_hold_bill"
                            android:textColor="@color/npos_orange" />

                        <TextView
                            android:id="@+id/restoreHoldButton"
                            style="@style/Npos.Btn.Chip"
                            android:layout_marginStart="4dp"
                            android:text="@string/btn_restore_hold"
                            android:textColor="@color/npos_orange" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/flushSyncButton"
                        style="@style/Npos.Btn.Ghost"
                        android:layout_marginTop="4dp"
                        android:text="@string/btn_flush_sync"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/payCashButton"
                        style="@style/Npos.Btn.Primary"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_pay_cash"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/payPromptButton"
                        style="@style/Npos.Btn.Secondary"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_pay_promptpay"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/xReportButton"
                        style="@style/Npos.Btn.Ghost"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_x_report" />

                    <!-- Kept for code wiring; nav moved to left rail -->
                    <View
                        android:id="@+id/backButton"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                    <View
                        android:id="@+id/receiptsButton"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                    <View
                        android:id="@+id/sellSettingsButton"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                    <View
                        android:id="@+id/sellCloseShiftButton"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/include_update_popup" />
</FrameLayout>
