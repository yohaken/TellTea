<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dot-path parents required by AAPT (Npos.Btn.Primary → Npos + Npos.Btn). -->
    <style name="Npos" />
    <style name="Npos.Text" parent="Npos" />
    <style name="Npos.Banner" parent="Npos" />

    <style name="Theme.Npos" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/npos_bg</item>
        <item name="android:textColorPrimary">@color/npos_ink</item>
        <item name="android:textColorSecondary">@color/npos_muted</item>
        <item name="android:colorPrimary">@color/npos_orange</item>
        <item name="android:colorAccent">@color/npos_orange</item>
        <item name="android:fontFamily">@font/prompt_regular</item>
        <item name="android:statusBarColor">@color/npos_bg</item>
        <item name="android:navigationBarColor">@color/npos_bg</item>
    </style>

    <style name="Npos.Text.Brand" parent="Npos.Text">
        <item name="android:fontFamily">@font/prompt_bold</item>
        <item name="android:textSize">@dimen/npos_text_brand</item>
        <item name="android:textColor">@color/npos_ink</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Npos.Text.Title" parent="Npos.Text">
        <item name="android:fontFamily">@font/prompt_semibold</item>
        <item name="android:textSize">@dimen/npos_text_title</item>
        <item name="android:textColor">@color/npos_ink</item>
    </style>

    <style name="Npos.Text.Section" parent="Npos.Text">
        <item name="android:fontFamily">@font/prompt_semibold</item>
        <item name="android:textSize">@dimen/npos_text_section</item>
        <item name="android:textColor">@color/npos_ink</item>
    </style>

    <style name="Npos.Text.Body" parent="Npos.Text">
        <item name="android:fontFamily">@font/prompt_regular</item>
        <item name="android:textSize">@dimen/npos_text_body</item>
        <item name="android:textColor">@color/npos_ink_soft</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Npos.Text.Caption" parent="Npos.Text">
        <item name="android:fontFamily">@font/prompt_regular</item>
        <item name="android:textSize">@dimen/npos_text_caption</item>
        <item name="android:textColor">@color/npos_muted</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <!-- Touch controls — TextView-based, compact (not full-bleed bars). -->
    <style name="Npos.Btn" parent="Npos">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/prompt_semibold</item>
        <item name="android:textSize">@dimen/npos_text_btn</item>
        <item name="android:maxWidth">@dimen/npos_btn_max_w</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
    </style>

    <style name="Npos.Btn.Primary" parent="Npos.Btn">
        <item name="android:background">@drawable/npos_touch_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:minHeight">@dimen/npos_btn_primary_h</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Npos.Btn.Secondary" parent="Npos.Btn">
        <item name="android:background">@drawable/npos_touch_secondary</item>
        <item name="android:textColor">@color/npos_orange</item>
        <item name="android:minHeight">@dimen/npos_btn_secondary_h</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Npos.Btn.Ghost" parent="Npos.Btn">
        <item name="android:background">@drawable/npos_touch_ghost</item>
        <item name="android:textColor">@color/npos_ink</item>
        <item name="android:fontFamily">@font/prompt_medium</item>
        <item name="android:minHeight">@dimen/npos_btn_ghost_h</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">@dimen/npos_text_btn_sm</item>
    </style>

    <style name="Npos.Btn.Chip" parent="Npos.Btn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/npos_touch_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/prompt_medium</item>
        <item name="android:textColor">@color/npos_ink</item>
        <item name="android:textSize">@dimen/npos_text_btn_sm</item>
        <item name="android:minHeight">@dimen/npos_btn_chip_h</item>
        <item name="android:maxWidth">999dp</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Npos.Btn.Chip.Primary" parent="Npos.Btn.Chip">
        <item name="android:background">@drawable/npos_touch_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/prompt_semibold</item>
    </style>

    <!-- Sell cart: full-width tap rows (easy at counter). -->
    <style name="Npos.Btn.SellRow" parent="Npos.Btn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxWidth">999dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:background">@drawable/npos_touch_ghost</item>
        <item name="android:textColor">@color/npos_ink</item>
        <item name="android:fontFamily">@font/prompt_semibold</item>
        <item name="android:minHeight">@dimen/npos_btn_secondary_h</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">@dimen/npos_text_btn</item>
    </style>

    <style name="Npos.Btn.SellRow.Primary" parent="Npos.Btn.SellRow">
        <item name="android:background">@drawable/npos_touch_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:minHeight">@dimen/npos_btn_primary_h</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Npos.Btn.SellRow.Accent" parent="Npos.Btn.SellRow">
        <item name="android:textColor">@color/npos_orange</item>
    </style>

    <style name="Npos.Btn.Back" parent="Npos.Btn.Ghost">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:maxWidth">999dp</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minHeight">36dp</item>
    </style>

    <style name="Npos.Input" parent="Npos">
        <item name="android:background">@drawable/npos_input_field</item>
        <item name="android:fontFamily">@font/prompt_regular</item>
        <item name="android:textColor">@color/npos_ink</item>
        <item name="android:textColorHint">@color/npos_muted</item>
        <item name="android:textSize">@dimen/npos_text_body</item>
        <item name="android:minHeight">@dimen/npos_btn_secondary_h</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Npos.Banner.Update" parent="Npos.Banner">
        <item name="android:background">@drawable/npos_banner_peach</item>
        <item name="android:fontFamily">@font/prompt_medium</item>
        <item name="android:textColor">@color/npos_orange</item>
        <item name="android:textSize">@dimen/npos_text_body</item>
        <item name="android:padding">14dp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
</resources>
